# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
# These are dummy values: none of them is a working credential.

# --- Database (PostgreSQL by default) --------------------------------
DB_URL=jdbc:postgresql://localhost:5432/booking_db
DB_USERNAME=booking_app
DB_PASSWORD=replace_with_your_local_password

# --- Database (MySQL alternative) ------------------------------------
# SPRING_PROFILES_ACTIVE=mysql
# DB_URL=jdbc:mysql://localhost:3306/booking_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# DB_USERNAME=booking_app
# DB_PASSWORD=replace_with_your_local_password

# --- JWT signing key (RS256) -----------------------------------------
# The RSA key pair lives in AWS Secrets Manager and nowhere else. There is no
# variable here that accepts key material: the application will not read a key
# from configuration, from a file, or generate one.
#
# Name or ARN of the secret holding the key pair. Required.
JWT_SECRET_ID=booking/jwt-signing-key
# Optional: otherwise taken from the standard AWS region chain.
AWS_REGION=eu-west-1
# Minutes between re-reads of the secret; 0 disables it (rotation then needs a restart).
JWT_KEY_REFRESH_MINUTES=0
# Credentials come from the default AWS provider chain (IAM role in production,
# AWS_PROFILE or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY locally). Never commit them.

# --- Token lifetimes --------------------------------------------------
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# --- Access-token blacklist ------------------------------------------
# in-memory (default: single instance and tests) | redis (more than one replica).
# With more than one replica this MUST be redis, or a logout is only honoured by
# the instance that served it. The redis-blacklist profile sets this and adds
# Redis to the readiness probe.
TOKEN_BLACKLIST=in-memory
# Only used when the blacklist is redis:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=replace_with_your_redis_password
# REDIS_SSL=false

# --- Refresh tokens ---------------------------------------------------
# Cron for the sweep of expired refresh tokens (default: hourly at :15).
# REFRESH_TOKEN_PURGE_CRON=0 15 * * * *

# --- Optional ---------------------------------------------------------
# SERVER_PORT=8080
# DB_POOL_SIZE=10
# validate (default) | none | update -- the schema itself comes from db/<engine>/02_schema.sql
# DDL_AUTO=validate
